{
  "name": "authservice",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "generate": "prisma generate",
    "copy-openapi": "node -e \"const fs=require('fs'); const p=require('path'); fs.cpSync(p.join('src','openapi'), p.join('dist','openapi'), {recursive:true, force:true});\"",
    "build": "npm run build --workspace=@repo/logger && npm run build --workspace=@repo/redis && npm run generate && node ../../node_modules/typescript/bin/tsc && npm run copy-openapi",
    "start": "node dist/index.js",
    "test": "vitest run"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.19",
    "@types/pg": "^8.20.0",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/supertest": "^6.0.3",
    "@types/yamljs": "^0.2.34",
    "eslint": "^9.39.4",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.3",
    "prisma": "^7.8.0",
    "tsx": "^4.22.3",
    "typescript": "^5.9.2",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
