    "@repo/logger": "*",
    "@repo/redis": "*",
    "cors": "^2.8.6",
    "dotenv": "^16.0.3",
    "express": "^5.2.1",
    "pg": "^8.21.0",
    "resend": "^6.12.3",
    "supertest": "^7.1.4",
    "swagger-ui-express": "^5.0.1",
    "yamljs": "^0.3.0"
  }
}
